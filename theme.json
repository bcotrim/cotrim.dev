{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "bg",        "color": "#0D0D0D",                    "name": "Background" },
				{ "slug": "surface",   "color": "#181818",                    "name": "Surface" },
				{ "slug": "code-bg",   "color": "#080808",                    "name": "Code Background" },
				{ "slug": "line",      "color": "rgba(255,255,255,0.09)",     "name": "Line" },
				{ "slug": "line-bold", "color": "rgba(255,255,255,0.14)",     "name": "Line Bold" },
				{ "slug": "ink",       "color": "#EDEDED",                    "name": "Ink" },
				{ "slug": "mute",      "color": "#ACACAC",                    "name": "Mute" },
				{ "slug": "dim",       "color": "#838383",                    "name": "Dim" },
				{ "slug": "faint",     "color": "#5A5A5A",                    "name": "Faint" },
				{ "slug": "green",     "color": "#3FE07B",                    "name": "Green" },
				{ "slug": "blue",      "color": "#6FE0EA",                    "name": "Cyan" },
				{ "slug": "amber",     "color": "#F8C463",                    "name": "Amber" },
				{ "slug": "pink",      "color": "#A98BFF",                    "name": "Violet" }
			],
			"gradients": [],
			"duotone": [],
			"defaultGradients": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"fontFamily": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"slug": "sans",
					"name": "Geist",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "https://fonts.gstatic.com/s/geist/v5/gyByhwUxId8gMEwcGFWNOITd.woff2" ]
						}
					]
				},
				{
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "https://fonts.gstatic.com/s/jetbrainsmono/v24/tDbv2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKwBNntkaToggR7BYRbKPx7cwgknk-6nFg.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "meta",    "size": "11px",    "name": "Meta" },
				{ "slug": "mono-sm", "size": "12px",    "name": "Mono Small" },
				{ "slug": "mono",    "size": "13px",    "name": "Mono" },
				{ "slug": "mono-md", "size": "13.5px",  "name": "Mono Medium" },
				{ "slug": "small",   "size": "15px",    "name": "Small" },
				{ "slug": "medium",  "size": "16px",    "name": "Medium" },
				{ "slug": "body",    "size": "17px",    "name": "Body" },
				{ "slug": "dek",     "size": "19px",    "name": "Dek" },
				{ "slug": "h2",      "size": "26px",    "name": "H2" },
				{ "slug": "page",    "size": "40px",    "name": "Page Title" },
				{ "slug": "post",    "size": "44px",    "name": "Post Title" },
				{ "slug": "hero",    "size": "48px",    "name": "Hero" }
			],
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"dropCap": false
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "size": "4px",  "name": "1" },
				{ "slug": "20", "size": "8px",  "name": "2" },
				{ "slug": "30", "size": "12px", "name": "3" },
				{ "slug": "40", "size": "16px", "name": "4" },
				{ "slug": "50", "size": "22px", "name": "5" },
				{ "slug": "60", "size": "32px", "name": "6" },
				{ "slug": "70", "size": "40px", "name": "7" },
				{ "slug": "80", "size": "48px", "name": "8" },
				{ "slug": "90", "size": "64px", "name": "9" },
				{ "slug": "side", "size": "48px", "name": "Side Padding" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"useRootPaddingAwareAlignments": true,
		"custom": {
			"uptime": { "since": "2024-06-01T00:00:00Z" },
			"version": "v3.0 · 2026.10"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg)",
			"text": "var(--wp--preset--color--mute)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.75",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" },
			"blockGap": "0"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "textDecoration": "none" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--blue)" },
					"typography": { "textDecoration": "none" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"lineHeight": "1.05"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--post)",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h2)",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "20px",
					"letterSpacing": "-0.3px",
					"lineHeight": "1.3"
				}
			},
			"button": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)",
					"style": "solid",
					"width": "1px",
					"radius": "7px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "12px",
					"fontWeight": "400"
				},
				"spacing": {
					"padding": { "top": "6px", "right": "12px", "bottom": "6px", "left": "12px" }
				},
				":hover": {
					"color": { "background": "transparent", "text": "var(--wp--preset--color--ink)" },
					"border": { "color": "var(--wp--preset--color--line-bold)" }
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": { "fontSize": "var(--wp--preset--font-size--body)", "lineHeight": "1.75" },
				"color": { "text": "var(--wp--preset--color--mute)" }
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--post)",
					"fontWeight": "600",
					"letterSpacing": "-0.03em",
					"lineHeight": "1.12"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "11px",
					"fontWeight": "400",
					"letterSpacing": "0.4px",
					"textTransform": "none"
				},
				"color": { "text": "var(--wp--preset--color--dim)" }
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--code-bg)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)",
					"style": "solid",
					"width": "1px",
					"radius": "10px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "13.5px",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": { "top": "16px", "right": "18px", "bottom": "16px", "left": "18px" }
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--code-bg)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": {
					"color": "var(--wp--preset--color--line)",
					"style": "solid",
					"width": "1px",
					"radius": "10px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "13.5px",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": { "top": "16px", "right": "18px", "bottom": "16px", "left": "18px" }
				}
			},
			"core/separator": {
				"color": { "background": "var(--wp--preset--color--line)" },
				"border": { "width": "1px 0 0 0", "color": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--line-bold)",
					"style": "solid",
					"width": "0 0 0 2px"
				},
				"spacing": {
					"padding": { "left": "20px" }
				},
				"color": { "text": "var(--wp--preset--color--dim)" }
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "12px"
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "12px"
				},
				"color": { "text": "var(--wp--preset--color--faint)" }
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "13.5px"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-projects", "title": "Projects",      "postTypes": [ "page" ] },
		{ "name": "page-now",      "title": "Now",           "postTypes": [ "page" ] }
	]
}
